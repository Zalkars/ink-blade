; Ink Blade Godot port
; One project exports to Windows and Android.

config_version=5

[application]
config/name="Чернильный клинок"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.937255, 0.894118, 0.8, 1)
boot_splash/image=""

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.937255, 0.894118, 0.8, 1)

[input]
move_left={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194311)]}
move_right={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194313)]}
move_up={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]}
jump={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventKey,"physical_keycode":90), Object(InputEventJoypadButton,"button_index":0)]}
attack={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":74), Object(InputEventKey,"physical_keycode":88), Object(InputEventJoypadButton,"button_index":2)]}
dash={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":75), Object(InputEventKey,"physical_keycode":4194325), Object(InputEventJoypadButton,"button_index":1)]}
heal={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":76), Object(InputEventKey,"physical_keycode":86), Object(InputEventJoypadButton,"button_index":3)]}
pause={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventKey,"physical_keycode":4194309), Object(InputEventJoypadButton,"button_index":7)]}
restart={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":82), Object(InputEventJoypadButton,"button_index":6)]}
help={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":112)]}
mute={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":77)]}
debug={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":113)]}

[audio]
default_device=""

[android]
gradle_build/use_gradle_build=true
package/unique_name="org.inkblade.game"
package/name="Ink Blade"
version/code=1
version/name="0.1.0"
permissions/audio_record=false

[gui]
theme/default_font_multichannel_signed_distance_field=true
